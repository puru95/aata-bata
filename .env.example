# Leave DATABASE_URL empty to use a local in-process Postgres (PGlite) in ./.data
# Production: Supabase pooler URL (Mumbai region), transaction mode
DATABASE_URL=

# Port for the Node server
PORT=3456

# Long random string; signs the ops login cookie
SESSION_SECRET=change-me-to-a-long-random-string

# Password for /ops (founders only)
ADMIN_PASSWORD=change-me

# Set to 1 behind HTTPS in production (secure cookies)
COOKIE_SECURE=0
